<!DOCTYPE module SYSTEM "module.dtd">
<module name="depth_estimation" dir="computer_vision/depth_estimation">
  <doc>
    <description>
      Monocular depth estimation using lightweight network from [Papa, (2023), https://doi.org/10.3390/s23042223]
    </description>
  </doc>
  <settings>
    <dl_settings>
      <dl_settings name="depth">
        <dl_setting var="depth_estimation.enabled" min="0" max="1" step="1" 
              shortname="depth_enable" module="depth_estimation"
              values="OFF|ON"/>
        <dl_setting var="depth_estimation.stream_enabled" min="0" max="1" step="1" 
                    shortname="stream_enable" module="depth_estimation"
                    values="OFF|ON"/>
      </dl_settings>
    </dl_settings>
  </settings>
  <header>
    <file name="depth_estimation.h"/>
    <!-- <file name="model_loader.h"/>
    <file name="inference.h"/>
    <file name="image_processor.h"/>
    <file name="stream_funcs.h"/>
    <file name="stb_image.h"/>
    <file name="stb_image_resize2.h"/> -->
  </header>
  <init fun="depth_estimation_init()"/>
  <periodic fun="depth_estimation_periodic()" freq="5"/>
  <makefile target="ap|nps">
    <!-- Setup Video Feed -->
    <configure name="VISION_LED" value="5"/>
    <define name="CAMERA_CAPTURE_MODE" value="1"/>
    <define name="VIDEO_THREAD" value="1"/>
    <define name="DEPTH_ESTIMATION_CAMERA" value="front_camera"/>

    <!-- Include the video streaming dependencies -->
    <file name="rtp.c" dir="modules/computer_vision/lib/encoding"/>
    <!-- Define the network connection -->
    <raw>
      DEPTH_RTP_PORT_OUT ?= 5100
      CFLAGS += -DDEPTH_RTP_PORT_OUT=$(DEPTH_RTP_PORT_OUT)
    </raw>

    <!-- Set port for custom stream -->
    <define name="DEPTH_RTP_PORT_OUT" value="5100"/>
    
    <!-- Include module source files -->
    <file name="depth_estimation.c"/>
    <!-- <file name="model_loader.c"/>
    <file name="inference.c"/>
    <file name="image_processor.c"/>
    <file name="stream_funcs.c"/> -->

    <!-- Include path to tensorflow-->
    <flag name="CFLAGS" value="I$(PAPARAZZI_HOME)/sw/ext/tflite_ARM/include"/>

    <!-- Link against TensorFlow Lite -->
    <raw>
      ifdef PAPARAZZI_HOME
      LDFLAGS += -L$(PAPARAZZI_HOME)/sw/ext/tflite_ARM/lib -ltensorflowlite_c
      endif
    </raw>

    <!-- Add math library -->
    <flag name="LDFLAGS" value="lm"/>

    <!-- Link to tflite model file -->
    <flag name="CFLAGS" value="DMODEL_PATH=\\\"$(PAPARAZZI_HOME)/conf/models/model.tflite\\\""/>


  </makefile>
</module>